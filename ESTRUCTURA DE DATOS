// Rectangulo.cs
// Esta clase representa una figura geométrica rectangular.
// Encapsula el ancho y la altura del rectángulo como sus propiedades principales.

public class Rectangulo
{
    // Propiedad privada para almacenar el ancho del rectángulo.
    // Se utiliza el tipo de dato primitivo 'double' para permitir valores decimales.
    private double ancho;

    // Propiedad privada para almacenar la altura del rectángulo.
    // Se utiliza el tipo de dato primitivo 'double' para permitir valores decimales.
    private double altura;

    // Constructor de la clase Rectangulo.
    // Este método se llama automáticamente cuando se crea una nueva instancia de Rectangulo.
    // Recibe parámetros 'anchoInicial' y 'alturaInicial' para inicializar las propiedades.
    public Rectangulo(double anchoInicial, double alturaInicial)
    {
        // Validación básica: asegura que ancho y altura sean positivos al inicializar.
        if (anchoInicial > 0 && alturaInicial > 0)
        {
            this.ancho = anchoInicial;
            this.altura = alturaInicial;
        }
        else
        {
            // Si los valores iniciales no son válidos, se establecen en 0 y se advierte en la consola.
            this.ancho = 0;
            this.altura = 0;
            System.Console.WriteLine("Advertencia: Ancho y altura iniciales deben ser positivos. Valores establecidos a 0.");
        }
    }

    // Método para obtener el valor actual del ancho.
    // Permite acceder al valor del ancho de forma controlada.
    public double ObtenerAncho()
    {
        return this.ancho;
    }

    // Método para establecer un nuevo valor para el ancho.
    // Permite modificar el valor del ancho de forma controlada.
    public void EstablecerAncho(double nuevoAncho)
    {
        // Validación: asegurar que el ancho sea positivo.
        if (nuevoAncho > 0)
        {
            this.ancho = nuevoAncho;
        }
        else
        {
            System.Console.WriteLine("Error: El ancho debe ser un valor positivo. No se aplicó el cambio.");
        }
    }

    // Método para obtener el valor actual de la altura.
    // Permite acceder al valor de la altura de forma controlada.
    public double ObtenerAltura()
    {
        return this.altura;
    }

    // Método para establecer un nuevo valor para la altura.
    // Permite modificar el valor de la altura de forma controlada.
    public void EstablecerAltura(double nuevaAltura)
    {
        // Validación: asegurar que la altura sea positiva.
        if (nuevaAltura > 0)
        {
            this.altura = nuevaAltura;
        }
        else
        {
            System.Console.WriteLine("Error: La altura debe ser un valor positivo. No se aplicó el cambio.");
        }
    }

    // Método para calcular el área del rectángulo.
    // Retorna un valor de tipo 'double' que representa el área.
    // Utiliza la fórmula A = ancho * altura.
    public double CalcularArea()
    {
        // Se multiplica el ancho por la altura para obtener el área.
        return this.ancho * this.altura;
    }

    // Método para calcular el perímetro del rectángulo.
    // Retorna un valor de tipo 'double' que representa el perímetro.
    // Utiliza la fórmula P = 2 * (ancho + altura).
    public double CalcularPerimetro()
    {
        // Se suma el ancho y la altura, y luego se multiplica por 2.
        return 2 * (this.ancho + this.altura);
    }
}
