CODIGO CIRCULO

// Circulo.cs
// Esta clase representa una figura geométrica circular.
// Encapsula el radio del círculo como su propiedad principal.

public class Circulo
{
    // Propiedad privada para almacenar el radio del círculo.
    // Se utiliza el tipo de dato primitivo 'double' para permitir valores decimales.
    private double radio;

    // Constructor de la clase Circulo.
    // Este método se llama automáticamente cuando se crea una nueva instancia de Circulo.
    // Recibe un parámetro 'radioInicial' para inicializar la propiedad 'radio'.
    public Circulo(double radioInicial)
    {
        // Validación básica: asegura que el radio sea positivo al inicializar.
        if (radioInicial > 0)
        {
            this.radio = radioInicial;
        }
        else
        {
            // Si el radio inicial no es válido, se establece un valor predeterminado o se lanza una excepción.
            // Aquí, lo establecemos en 0 y mostramos un mensaje de advertencia en la consola.
            System.Console.WriteLine("Advertencia: El radio inicial debe ser positivo. Radio establecido a 0.");
        }
    }

   // Método para obtener el valor actual del radio.
    // Este es un "getter" que permite acceder al valor del radio de forma controlada.
    public double ObtenerRadio()
    {
        return this.radio;
    }

    // Método para establecer un nuevo valor para el radio.
    // Este es un "setter" que permite modificar el valor del radio de forma controlada.
    // Recibe un parámetro 'nuevoRadio' que será el nuevo valor del radio.
    public void EstablecerRadio(double nuevoRadio)
    {
        // Se añade validación para asegurar que el radio no sea negativo o cero.
        if (nuevoRadio > 0)
        {
            this.radio = nuevoRadio;
        }
        else
        {
            // Opcional: Se puede lanzar una excepción (throw new ArgumentException("El radio debe ser positivo.");)
            // o simplemente mostrar un mensaje de error en la consola.
            System.Console.WriteLine("Error: El radio debe ser un valor positivo. No se aplicó el cambio.");
        }
    }

    // Método para calcular el área del círculo.
    // Retorna un valor de tipo 'double' que representa el área.
    // Utiliza la constante Math.PI y la fórmula A = PI * radio^2.

    public double CalcularArea()
    {
        // Math.PI es una constante predefinida en C# que representa el valor de Pi (aproximadamente 3.14159).
        // Se multiplica Pi por el radio al cuadrado (radio * radio).
        return Math.PI * this.radio * this.radio;
    }

    // Método para calcular el perímetro (circunferencia) del círculo.
    // Retorna un valor de tipo 'double' que representa el perímetro.
    // Utiliza la fórmula P = 2 * PI * radio.
    public double CalcularPerimetro()
    {
        // Se multiplica 2 por Pi y por el radio.
        return 2 * Math.PI * this.radio;
    }
}

